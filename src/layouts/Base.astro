---
import '../styles/global.css';
import '../styles/laptop.css';
import trackingJs from '../scripts/tracking.js?raw';
import site from '../data/site.json';

const { t, path } = Astro.props;
const m = t.meta;
const D = site.domain;

// ---- JSON-LD для Google: организация, сайт, страница, FAQ (всё берётся из data/<язык>.json)
const org = {
  '@type': ['Organization', 'ProfessionalService'], '@id': D + '/#org', name: 'AIVA GROUP', legalName: site.legalName,
  url: 'https://aivagroup.uz', logo: D + '/logo.svg', image: D + '/og-image.png', telephone: site.phone, foundingDate: '2011',
  areaServed: [{ '@type': 'Country', name: 'Uzbekistan' }],
  address: { '@type': 'PostalAddress', streetAddress: 'ул. Буюк Турон, 77', addressLocality: 'Ташкент', addressCountry: 'UZ' },
  sameAs: [site.telegram.replace('https://t.me/', 'https://t.me/'), site.instagram],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: m.title, itemListElement: m.jsonldServices.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.description, provider: { '@id': D + '/#org' } } })) },
};
const strip = (h) => h.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    org,
    { '@type': 'WebSite', '@id': D + '/#site', url: D + '/', name: 'AIVA GROUP — коммерческое предложение', inLanguage: ['ru', 'uz'], publisher: { '@id': D + '/#org' } },
    { '@type': 'WebPage', '@id': m.url + '#page', url: m.url, name: m.title, description: m.desc, inLanguage: t.lang, isPartOf: { '@id': D + '/#site' }, about: { '@id': D + '/#org' } },
    { '@type': 'FAQPage', mainEntity: t.faq.items.map((f) => ({ '@type': 'Question', name: strip(f.q), acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })) },
  ],
};
---
<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{m.title}</title>
<meta name="description" content={m.desc}>
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">
<link rel="canonical" href={m.url}>
<meta name="theme-color" content="#070b1a">
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
<script is:inline set:html={trackingJs}></script>
<meta property="og:type" content="website">
<meta property="og:site_name" content="AIVA GROUP">
<meta property="og:title" content={m.ogt}>
<meta property="og:description" content={m.ogd}>
<meta property="og:url" content={m.url}>
<meta property="og:locale" content={m.locale}>
<meta property="og:locale:alternate" content={m.alt}>
<meta property="og:image" content={D + '/og-image.png'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={m.ogt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={m.ogt}>
<meta name="twitter:description" content={m.ogd}>
<meta name="twitter:image" content={D + '/og-image.png'}>
<link rel="alternate" hreflang="ru" href={D + '/'}>
<link rel="alternate" hreflang="uz" href={D + '/uz'}>
<link rel="alternate" hreflang="x-default" href={D + '/'}>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline></script>
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<slot />
</body>
</html>
